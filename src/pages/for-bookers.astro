---
import Layout from "../layouts/Layout.astro";
import HeroBookers from "../components/HeroBookers.astro";
import BookerFeatures from "../components/BookerFeatures.astro";
import GreatSpots from "../components/GreatSpots.astro";
import BookerFAQSection from "../components/BookerFAQSection.astro";
import CTAForBookers from "../components/CTAForBookers.astro";
import { webPageSchema, breadcrumbSchema, faqSchema } from "../lib/seo";
import { bookerFaqs } from "../data/faqs";

const title = "Hire Village Halls & Community Venues | Haveaspot";
const description = "Find and book village halls, school spaces, sports venues and community rooms for your event, class or party. Secure online payment and a small booking fee.";
const schema = [
	webPageSchema({ path: "/for-bookers", title, description, type: "WebPage" }),
	breadcrumbSchema([{"name": "For Bookers", "path": "/for-bookers"}]),
	faqSchema(bookerFaqs),
];
---

<Layout
	title={title}
	description={description}
	schema={schema}
>
	<HeroBookers />
	<BookerFeatures />
	<GreatSpots />
	<BookerFAQSection />
	<CTAForBookers />
</Layout>
