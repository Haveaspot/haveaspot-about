---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SubNav from "../components/SubNav.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	schema?: Record<string, unknown>[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	imageAlt,
	noindex,
	schema,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} schema={schema} />
	</head>
	<body>
		<Header />
		<SubNav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
